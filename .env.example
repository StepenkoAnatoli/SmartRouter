# Anthropic API — Phase 4 pilot key placement (row-4 approval: gitignored local .env)
# Copy this file to `.env` and fill in real values. NEVER commit .env — it is
# excluded by .gitignore and guarded by the tools/check_secrets.py scan.
#
# Only the approved endpoint (api.anthropic.com, row-4 §3 egress destinations)
# is used; the dispatcher's dispatch_fn must construct requests against it.

# Anthropic API key (starts with sk-ant-). Required for live dispatch only;
# dry-run mode needs nothing here.
ANTHROPIC_API_KEY=

# Optional: pin the base URL so a misconfigured client cannot silently egress
# to a non-approved endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Anthropic API version header for reproducibility of pilot runs.
ANTHROPIC_API_VERSION=2023-06-01
